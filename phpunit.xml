<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <!-- Pinned so the suite asserts the app's real locale and timezone
             instead of whatever the developer's local .env happens to hold. -->
        <env name="APP_LOCALE" value="es"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="APP_FAKER_LOCALE" value="es_AR"/>
        <env name="APP_TIMEZONE" value="America/Argentina/Buenos_Aires"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Destination for the SQLite -> PostgreSQL export tests. Left empty by
             default so those tests skip; set them (or export the same names in
             the shell) to run them against a disposable PostgreSQL. -->
        <env name="EXPORT_TEST_PG_HOST" value=""/>
        <env name="EXPORT_TEST_PG_PORT" value="5432"/>
        <env name="EXPORT_TEST_PG_DATABASE" value="postgres"/>
        <env name="EXPORT_TEST_PG_USERNAME" value="postgres"/>
        <env name="EXPORT_TEST_PG_PASSWORD" value=""/>
    </php>
</phpunit>
