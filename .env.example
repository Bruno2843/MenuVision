# ---------------------------------------------------------------------------
# MenuVision environment
# ---------------------------------------------------------------------------
#
# Everything below works as it stands, with no configuration at all: SQLite on
# disk and photographs and 3D models under `storage/app/public`. Copy this file
# to `.env`, run `php artisan key:generate`, `php artisan migrate --seed` and the
# app is up. Nothing in the Supabase section is read until `MENUVISION_DISK` or
# `DB_CONNECTION` points at it, so leaving those blocks commented is the normal
# state for local work.
#
# Production runs the exact same build and only differs by environment: a
# PostgreSQL database reached through the Supabase pooler, and a bucket for the
# dish media. There are two places that must not be confused:
#
#   * the database connection (`DB_*`), which needs the pooler host and port;
#   * the object storage (`AWS_*` plus `MENUVISION_DISK`), which needs S3
#     credentials and the bucket name.
#
# Never commit real values to this file.

APP_NAME=MenuVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Origin the QR codes point at, read by the phones of the clients. Leave it empty
# and the QR encodes the host that served the panel, which only the computer
# running Herd can open. To try MenuVision from a phone or a tablet on the same
# Wi-Fi, put here the LAN address of this machine and the port Laravel listens
# on, for example:
#
#     QR_BASE_URL=http://192.168.1.50:8000
#
# Only the origin goes here; `/menu/TOKEN` is still built from the route, so the
# codes already printed keep working and no row changes when the address does.
QR_BASE_URL=

APP_LOCALE=es
# The app is in Spanish; English stays as the fallback for any key the
# lang/es files do not cover yet.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# Local development: SQLite, a single file. `DB_DATABASE` is left unset so the
# connection falls back to `database/database.sqlite`; the only file that must
# exist is that one, and `php artisan migrate` creates the tables in it.
#
# Production: PostgreSQL through the Supabase **Session Pooler**, not the direct
# database host. The direct host resolves to IPv6 only and Render cannot reach
# it, so the pooler host is the one that works from a container. Copy the
# host, port and user prefix verbatim from the Supabase dashboard, under
# "Connect" -> "Session pooler"; they are not derivable from the project URL.
# The pooler user is typically `postgres.<project-ref>`.
#
# DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=db.<project-ref>.supabase.co          # direct host: IPv6 only, avoid
# DB_HOST=aws-0-<region>.pooler.supabase.com    # Session Pooler host (example)
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
# DB_SSLMODE=require

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# The disk that holds photographs and 3D models. `public` writes under
# `storage/app/public` and is served through the `/storage` symlink, which is
# what local development wants. `supabase` writes to the bucket configured in
# the AWS block below, so the files outlive a container restart.
MENUVISION_DISK=public
# MENUVISION_DISK=supabase

# ---------------------------------------------------------------------------
# Object storage (Supabase Storage, S3 protocol)
# ---------------------------------------------------------------------------
#
# Only read when MENUVISION_DISK=supabase. Supabase Storage exposes an
# S3-compatible endpoint, so the regular S3 driver reaches it.
#
# The `sb_publishable_...` and `sb_secret_...` keys from the Supabase dashboard
# are API keys for the Supabase client libraries. They are NOT S3 credentials
# and cannot be used here: the S3 endpoint rejects them. Create a Storage
# access key pair instead (dashboard: Storage -> S3 connection, or Project
# Settings -> Storage), and use that Access Key ID and Secret.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=            # the region shown next to the S3 endpoint
# AWS_BUCKET=                    # the bucket that holds platos/ and models/
# AWS_ENDPOINT=                  # https://<project-ref>.supabase.co/storage/v1/s3
# AWS_USE_PATH_STYLE_ENDPOINT=true
# AWS_URL=                       # public read prefix of the bucket:
#                                # https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#
# `AWS_URL` must be the object URL, not the S3 endpoint: browsers cannot sign
# requests, so the endpoint above only works for uploads and deletes. The bucket
# has to be public for reads, otherwise the menu images will render broken.
#
# Local development leaves all of this unused.
#
# PENDING, separate from the data import: moving the files that already exist
# (`platos/*` photographs and `models/*.glb`) into the bucket has NOT been
# implemented. It needs the S3 credentials above and a dedicated, non
# destructive command that verifies each copy before anything is deleted. Until
# then, leave MENUVISION_DISK=public in production too, so the menu keeps serving
# the files the container ships with.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Deploy
# ---------------------------------------------------------------------------
#
# Migrations are deliberately not run on container boot: a deploy should not
# reshape the production database on its own. Run `php artisan migrate --force`
# once from the Render shell, then leave this false. The entrypoint never seeds
# users, because the seeder resets the demo passwords.
#
# On the production service also set APP_ENV=production, APP_DEBUG=false,
# APP_URL=https://<your-service>.onrender.com and QR_BASE_URL to the same
# https origin, so the table QR codes point at the public address.
#
# The database variables have to be entered in the Render dashboard, under the
# service's Environment tab; they are never committed. The pairs this project
# uses are:
#
#   DB_CONNECTION=pgsql
#   DB_HOST=<session-pooler host>          # e.g. aws-0-<region>.pooler.supabase.com
#   DB_PORT=5432
#   DB_DATABASE=postgres
#   DB_USERNAME=postgres.<project-ref>
#   DB_PASSWORD=<storage password>         # treat as a secret, paste as-is
#   DB_SSLMODE=require
#   MENUVISION_DISK=public                 # unchanged until Storage is set up
#   RUN_MIGRATIONS_ON_BOOT=false
#
# Keep the password as its own variable rather than inside a `DB_URL`: in a URI
# every reserved character (`@ : / ? # &`) must be percent-encoded, and doing
# that by hand is how a working password starts failing. As a standalone
# DB_PASSWORD it is used verbatim.
#
# Once the schema exists, copy the local SQLite data once, from the Render
# shell:
#
#   php artisan menuvision:export-sqlite-to-postgres --dry-run   # review
#   php artisan menuvision:export-sqlite-to-postgres --write     # only if it looks right

VITE_APP_NAME="${APP_NAME}"

